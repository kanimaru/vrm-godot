# Godot 4+ specific ignores
.godot/
/android/

# IDE
.idea/

# GUT test run output
gut_out.txt

# graphify: machine-local paths and regenerable extraction cache
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cache/

# Licensed VRM avatars - not redistributable, kept locally only
/assets/luna/
/assets/temptic/
/assets/dove/

# Per-machine dotquay links; holds absolute paths.
dotquay.local.toml

# Per-machine dotquay links; hold absolute paths.
dotquay.local.targets

# The MToon shader addon is installed by `dotquay install` from dotquay.lock (and is a local
# link to F:\projects\godot\mtoon-shader on the dev machine) - not tracked here. It used to be
# committed under the wrong folder name, addons/mtoon-shader; the addon references itself as
# res://addons/Godot-MToon-Shader/ (install_as in dotquay.toml).
addons/Godot-MToon-Shader/
