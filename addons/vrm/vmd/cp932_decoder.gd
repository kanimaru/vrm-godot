class_name CP932Decoder
extends Object

## A helper class to decode CP932 (Shift-JIS) strings from binary data.
## Used primarily for parsing VMD file headers and bone names.

static var _mapping: Dictionary = {}

## Decodes a PackedByteArray containing CP932 encoded text.
static func decode(data: PackedByteArray) -> String:
	if _mapping.is_empty():
		_load_mapping()
	
	var result := ""
	var i := 0
	while i < data.size():
		var b1 := data[i]
		
		# 1. Null terminator or padding (MMD specific)
		if b1 == 0 or b1 == 0xFD:
			break
			
		# 2. ASCII range (0x00 - 0x7F)
		if b1 <= 0x7F:
			result += char(b1)
			i += 1
			continue
			
		# 3. Half-width Katakana (0xA1 - 0xDF)
		# These map to Unicode U+FF61 to U+FF9F
		if b1 >= 0xA1 and b1 <= 0xDF:
			result += char(b1 + 0xFEC0)
			i += 1
			continue
			
		# 4. Multi-byte range (Lead bytes: 0x81-0x9F, 0xE0-0xFC)
		if i + 1 < data.size():
			var b2 := data[i + 1]
			var code := (b1 << 8) | b2
			
			# Check our lookup table
			var unicode = _mapping.get(str(code))
			if unicode != null:
				result += char(int(unicode))
			else:
				result += "?" # Fallback for unmapped characters
			i += 2
		else:
			# Orphaned lead byte at end of data
			result += "?"
			i += 1
			
	return result

static func _load_mapping() -> void:
	# Using the JSON mapping generated by the Python script
	var path := "res://addons/vrm/vmd/cp932_map.json"
	if not FileAccess.file_exists(path):
		printerr("CP932Decoder: Mapping file missing: ", path)
		return
		
	var file := FileAccess.open(path, FileAccess.READ)
	if not file:
		printerr("CP932Decoder: Failed to open mapping file.")
		return
		
	var json := JSON.new()
	var err := json.parse(file.get_as_text())
	if err == OK:
		_mapping = json.data
	else:
		printerr("CP932Decoder: JSON Parse Error at line ", json.get_error_line(), ": ", json.get_error_message())
